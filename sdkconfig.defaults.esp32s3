# ESP32-S3 target defaults - default to ESP32-S3 Generic board
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y

# Dedicated cache SRAM: give flash code and PSRAM data more cache space.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# USB speaker source (PC -> DAC) + HID wake.  Composite mode: the app owns
# tusb_config.h / descriptors.  Speaker only: the microphone direction is
# the upstream AUDIO_OUTPUT_USB feature and is not built here.  48 kHz is
# mandatory: the UAC component drains its FIFO at (rate/1000) bytes per USB
# frame with integer division, so any rate not a multiple of 1000 Hz drifts.
CONFIG_USB_AUDIO_SOURCE=y
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=0
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SUPPORT_MACOS=n
# Isochronous transfers have a 1 ms deadline: keep the USB stack above the
# audio render task and on the audio core, away from WiFi (core 0).
CONFIG_UAC_TINYUSB_TASK_PRIORITY=10
CONFIG_UAC_TINYUSB_TASK_CORE=1
CONFIG_UAC_SPK_TASK_PRIORITY=8
CONFIG_UAC_SPK_TASK_CORE=1

# GPIO defaults
CONFIG_BAT_CHANNEL=7
CONFIG_LED_RGB_GPIO=48
CONFIG_I2S_SCK_IO=8
CONFIG_I2S_BCK_IO=11
CONFIG_I2S_WS_IO=13
CONFIG_I2S_DO_IO=12
CONFIG_I2S_GND_IO=14

# ST7789 TFT display support is not enabled by default.
# The display is optional hardware — enabling it configures specific SPI
# GPIO pins which may conflict with other peripherals on your board.
# To enable, add the following to your own sdkconfig.defaults.esp32s3
# or run: idf.py menuconfig -> Display Configuration
#
# CONFIG_DISPLAY_ENABLED=y
# CONFIG_DISPLAY_DRIVER_ST7789=y
# CONFIG_DISPLAY_BUS_SPI=y
# CONFIG_DISPLAY_SPI_CLK=18
# CONFIG_DISPLAY_SPI_MOSI=17
# CONFIG_DISPLAY_SPI_CS=15
# CONFIG_DISPLAY_SPI_DC=16
# CONFIG_DISPLAY_SPI_RST=21
# CONFIG_DISPLAY_BL_GPIO=38
# CONFIG_DISPLAY_UPDATE_MS=500
#
# LVGL configuration (required when display is enabled):
# CONFIG_LV_CONF_SKIP=y
# CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_MEM_SIZE_KILOBYTES=64
# CONFIG_LV_USE_LABEL=y
# CONFIG_LV_USE_BAR=y
# CONFIG_LV_USE_THEME_DEFAULT=y
# CONFIG_LV_FONT_MONTSERRAT_14=y
# CONFIG_LV_FONT_MONTSERRAT_16=y
# CONFIG_LV_FONT_MONTSERRAT_24=y
# CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
#
# See components/display/README.md for full setup instructions.

# --- Fable 5.1 personal-board profile (ESP32-S3 + PCM5102A) -----------------
# Fixed 48 kHz output.  AirPlay's 44.1 kHz is resampled by the sinc resampler;
# the USB speaker path runs natively at 48 kHz.  The I2S clock is configured
# once at boot and never switched, so source changes cannot pop or skew the
# timing engine's pipeline measurement.
CONFIG_OUTPUT_SAMPLE_RATE_48000=y

# Keep lwIP's TCP/IP task on core 0 with WiFi.  With no affinity it floats
# onto core 1 and preempts the audio and USB tasks in bursts.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# OTA rollback: a new image must call esp_ota_mark_app_valid_cancel_rollback()
# once the network and AirPlay stack are up, otherwise the bootloader reverts
# to the previous image on the next reset.  NOTE: this only takes effect after
# the bootloader itself is reflashed over the COM port once.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Compile DEBUG-level logs in (but keep INFO as the default) so the WebUI can
# raise the level of individual tags at runtime for diagnostics.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# No serial console at all.  Nobody reads UART0 on this board, yet every log
# line still blocked the calling task for ~13 ms at 115200 baud — three lines
# from the render task at a seek were enough to run the 42 ms DMA ring dry
# (observed: an underrun and a -15 ms jump on every seek).  The secondary
# USB-Serial-JTAG console must also go: it shares the PHY with the OTG
# speaker device.  All logs are captured by log_stream into the PSRAM
# journal and served over WiFi.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# /api/tasks: FreeRTOS task states (a task stuck in Blocked vs Ready is the
# difference between a lock wait and a busy loop) — no serial console here.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
# Avoid the 32-bit microsecond counter wrapping after about 71 minutes.
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
